{
  "name": "deepseek-studio",
  "version": "2.0.0",
  "description": "Connect DeepSeek Chat to any MCP server via a local bridge + Vue 3 Chrome extension.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run bridge/server.js",
    "dev": "bun --watch run bridge/server.js",
    "install:bridge": "cd bridge && bun install",
    "setup": "bun run install:bridge && cd extension && bun install",
    "build:ext": "cd extension && bunx wxt build",
    "dev:ext": "cd extension && bunx wxt"
  },
  "keywords": [
    "deepseek",
    "mcp",
    "model-context-protocol",
    "chrome-extension",
    "vue3",
    "wxt",
    "bun",
    "ai-tools"
  ],
  "author": "domz-1 (Adham)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/domz-1/deepseek-studio.git"
  }
}
