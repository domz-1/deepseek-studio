{
  "manifest_version": 3,
  "name": "DeepSeek MCP Studio",
  "short_name": "DS MCP",
  "description": "Connect DeepSeek Chat to real MCP tools (filesystem, bash, memory and more) through a local bridge. @mention tools, preview and run them with one click.",
  "version": "1.1.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "DeepSeek MCP Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "skills.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}